{
  // PTT Radio relay on Cloudflare Workers (free plan). One Durable Object holds every channel.
  "name": "ptt-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-04-07",
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }]
}
